cff-version: 1.2.0
message: "If you use this software, please cite it using the metadata below."
title: "Minimum-Snap-Trajectories"
abstract: >-
  Real-time minimum-snap B-spline trajectory generation for multirotors flying through
  cluttered, partially-unknown environments, using Safe Flight Corridors and OSQP. C++17
  engine with Python bindings.
type: software
authors:
  - given-names: Alejandro
    family-names: Pelaez
    orcid: "https://orcid.org/0009-0009-0848-4365"
    affiliation: "MAGICC Lab, Brigham Young University"
  - given-names: Brady
    family-names: Moon
    orcid: "https://orcid.org/0000-0003-4297-3938"
    affiliation: "FROST Lab, Brigham Young University"
  - given-names: Randal
    family-names: Beard
    orcid: "https://orcid.org/0000-0002-2548-5329"
    affiliation: "MAGICC Lab, Brigham Young University"
license: BSD-3-Clause
repository-code: "https://github.com/byu-magicc/Minimum-Snap-Trajectories"
version: 0.1.0
keywords:
  - trajectory optimization
  - minimum snap
  - B-splines
  - safe flight corridors
  - quadrotors
  - motion planning
